# Приложение
NODE_ENV=development
PORT=4000
APP_PORT=4000

# Логирование
LOG_LEVEL=info
LOG_MAX_FILE_SIZE_KB=10240
LOG_ERROR_FILE_PATH=logs/errors.log
LOG_COMBINED_FILE_PATH=logs/combined.log

# Аутентификация (учебные значения)
CRYPT_SALT=10
JWT_SECRET_KEY=education-secret-key-2025
JWT_SECRET_REFRESH_KEY=education-refresh-key-2025
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# База данных (Docker Compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=music_service

# TypeORM
TYPEORM_CONNECTION=postgres
TYPEORM_HOST=postgres
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=postgres
TYPEORM_DATABASE=music_service
TYPEORM_SYNCHRONIZE=true      # Для учебного проекта можно true
TYPEORM_LOGGING=true
TYPEORM_ENTITIES=dist/**/*.entity.js
TYPEORM_MIGRATIONS=dist/migrations/*.js
TYPEORM_MIGRATIONS_RUN=true

# Docker Hub (не обязательно)
DOCKER_USERNAME=your_dockerhub_username
DOCKER_PASSWORD=your_dockerhub_password
